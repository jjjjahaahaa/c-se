# Vorlage für die lokale .env-Datei (die echte .env steht in .gitignore und wird nie committet).
# Kopieren:  cp .env.example .env   und den Key eintragen.
# Ohne Key läuft alles offline mit der lokalen Strategie.

# API-Key für TypeSafe Jev (https://console.typesafe.ai/keys). JEV_API_KEY geht auch.
TYPESAFE_API_KEY=

# Optional: festes Modell statt jev-latest (empfohlen für reproduzierbare Ergebnisse)
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0
